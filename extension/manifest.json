{
  "manifest_version": 3,
  "name": "Handrail",
  "version": "0.1.0",
  "description": "Record your own clicks. Replay a guide that highlights the next step.",
  "minimum_chrome_version": "120",
  "permissions": ["storage", "activeTab", "scripting"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Handrail — your next step" },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'" }
}
